# Copy to .env for local runs. Names only; never commit real values.
AGENTREE_ENVIRONMENT=dev
# App runtime: must use the unprivileged agentree_app role.
AGENTREE_DATABASE_URL=
# Migrations only: agentree_migrator (schema owner).
AGENTREE_MIGRATION_DATABASE_URL=
AGENTREE_LOG_LEVEL=INFO

# Web app origin(s) allowed to call state-changing API endpoints (JSON list) and link base URL.
AGENTREE_ALLOWED_ORIGINS=
AGENTREE_PUBLIC_BASE_URL=
# Reverse proxies in front of the API that append X-Forwarded-For (0 locally, 1 behind Caddy).
AGENTREE_TRUSTED_PROXY_COUNT=0
# Keep true outside local http development.
AGENTREE_SESSION_COOKIE_SECURE=true

# BYOK vault: base64 of 32 random bytes. Generate:
#   uv run python -c "from agentree.core.vault import generate_master_key as g; print(g())"
# Rotation: move the old key into AGENTREE_PREVIOUS_MASTER_KEYS='{"k1":"<old>"}' and set a new
# AGENTREE_MASTER_KEY + AGENTREE_MASTER_KEY_ID; secrets re-wrap lazily on next use.
AGENTREE_MASTER_KEY=
AGENTREE_MASTER_KEY_ID=k1
AGENTREE_PREVIOUS_MASTER_KEYS=

# Outbound email (Mailpit in dev: host mailpit/localhost, port 1025, no TLS).
AGENTREE_MAIL_FROM=
AGENTREE_SMTP_HOST=
AGENTREE_SMTP_PORT=
AGENTREE_SMTP_USERNAME=
AGENTREE_SMTP_PASSWORD=
AGENTREE_SMTP_STARTTLS=

# Worker retention job (AGT-010): raw conversations idle longer than N days (1..30) are deleted.
AGENTREE_RETENTION_DAYS=30
AGENTREE_RETENTION_INTERVAL_SECONDS=3600

# One-time role bootstrap (python -m agentree.core.db_roles), run by an administrator.
AGENTREE_ADMIN_DATABASE_URL=
AGENTREE_APP_DB_PASSWORD=
AGENTREE_MIGRATOR_DB_PASSWORD=

# Tests: a PostgreSQL server URL with a role allowed to CREATE DATABASE and CREATE ROLE.
AGENTREE_TEST_DATABASE_URL=
