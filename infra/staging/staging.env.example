# Agentree staging secrets: TEMPLATE ONLY. Names and placeholders, never real values.
# On the server: copy to ~/agentree-secrets/staging.env, fill in, `chmod 600`.
# Never commit the filled file, paste it in chat, or print it in logs.
# Passwords: `openssl rand -hex 24` (hex keeps them URL-safe).

# Public hostname served by the host Caddy (https is implied).
AGENTREE_PUBLIC_HOST=tryagentree.com
# Loopback port the web container publishes (TRACK uses 3102, IELTS 3101).
AGENTREE_WEB_PORT=3103

# PostgreSQL: admin (bootstrap only), schema owner (migrations), unprivileged app role.
POSTGRES_ADMIN_PASSWORD=
AGENTREE_MIGRATOR_DB_PASSWORD=
AGENTREE_APP_DB_PASSWORD=

# BYOK vault master key for staging only (never the dev key, never production's).
# Generate on the server; keep two offline copies (docs/operations/MASTER_KEY.md).
AGENTREE_MASTER_KEY=
AGENTREE_MASTER_KEY_ID=staging-k1

# Transactional email (e.g. Brevo free tier). STARTTLS is forced on.
AGENTREE_MAIL_FROM="Agentree Demo <no-reply@tryagentree.com>"
AGENTREE_SMTP_HOST=smtp-relay.brevo.com
AGENTREE_SMTP_PORT=587
AGENTREE_SMTP_USERNAME=
AGENTREE_SMTP_PASSWORD=

# Web Push alerts (Task 13b). Generated on the server, never copied anywhere (runbook):
#   echo "AGENTREE_VAPID_PRIVATE_KEY=$(openssl ecparam -name prime256v1 -genkey -noout -outform DER | base64 -w0)" >> ~/agentree-secrets/staging.env
# Changing it later makes every device turn alerts on again. Empty = push off (email only).
AGENTREE_VAPID_PRIVATE_KEY=
# Contact sent to browser push services (mailto: or https URL); defaults to the site URL.
AGENTREE_VAPID_SUBJECT=

# Monitoring: token for GET /api/internal/metrics (header X-Agentree-Metrics-Token).
# Leave empty to disable the endpoint.
AGENTREE_METRICS_TOKEN=

# Set by deploy.sh to the deployed commit; leave unset here.
# AGENTREE_IMAGE_TAG=
